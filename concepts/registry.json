        ],
        "show_current_value": true,
        "vol": 0.20,
        "rate": 0.05,
        "time_to_expiry": 0.25
      },
      "examples": [
        {
          "label": "Bull Call Spread (100/110)",
          "config": {
            "spot": 100,
            "legs": [
              { "type": "call", "strike": 100, "premium": 5, "qty": 1 },
              { "type": "call", "strike": 110, "premium": 2, "qty": -1 }
            ],
            "time_to_expiry": 0.25
          }
        },
        {
          "label": "Bear Put Spread (100/90)",
          "config": {
            "spot": 100,
            "legs": [
              { "type": "put", "strike": 100, "premium": 5, "qty": 1 },
              { "type": "put", "strike": 90, "premium": 2, "qty": -1 }
            ],
            "time_to_expiry": 0.25
          }
        },
        {
          "label": "Long Call (Single Leg)",
          "config": {
            "spot": 100,
            "legs": [
              { "type": "call", "strike": 100, "premium": 5, "qty": 1 }
            ],
            "time_to_expiry": 0.25
          }
        }
      ],
      "prose_ref": "concepts/prose/strategy-spread-vertical.md",
      "related": ["black-scholes", "var"]
